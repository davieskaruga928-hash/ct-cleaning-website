# Copy this file to .env and fill in real values. Never commit .env itself.

# Leave unset to use a local SQLite file (quotes.db) — good for local testing.
# Set this to use PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://username:password@localhost:5432/ct_cleaning
DATABASE_URL=

# Password required to view/manage leads in the admin dashboard.
ADMIN_PASSWORD=changeme
